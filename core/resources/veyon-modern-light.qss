/* Veyon modern light / flat theme (Fluent-inspired).
 * Applied from VeyonCore::initUi() when the UI color scheme is Light. */

* {
	font-size: 13px;
}

QWidget {
	background-color: #f3f3f3;
	color: #1a1a1a;
	selection-background-color: #198cb3;
	selection-color: #ffffff;
}

QMainWindow,
QDialog,
QWizard {
	background-color: #f3f3f3;
}

QFrame {
	background-color: transparent;
	color: #1a1a1a;
}

QLabel {
	background-color: transparent;
	color: #1a1a1a;
	padding: 1px;
}

QGroupBox {
	background-color: #ffffff;
	border: 1px solid #d0d0d0;
	border-radius: 6px;
	margin-top: 14px;
	padding: 10px 8px 8px 8px;
	font-weight: 600;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 6px;
	color: #444444;
}

QPushButton {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c8c8c8;
	border-radius: 4px;
	padding: 6px 14px;
	min-height: 22px;
}

QPushButton:hover {
	background-color: #eef8fc;
	border-color: #198cb3;
}

QPushButton:pressed {
	background-color: #e0e0e0;
}

QPushButton:disabled {
	background-color: #f0f0f0;
	color: #9a9a9a;
	border-color: #e0e0e0;
}

QPushButton:default {
	background-color: #198cb3;
	border-color: #198cb3;
	color: #ffffff;
}

QPushButton:default:hover {
	background-color: #1fa3ce;
}

QToolButton {
	background-color: transparent;
	color: #1a1a1a;
	border: 1px solid transparent;
	border-radius: 4px;
	padding: 4px 8px;
	margin: 1px;
}

QToolButton:hover {
	background-color: #e8e8e8;
	border-color: #d0d0d0;
}

QToolButton:pressed,
QToolButton:checked {
	background-color: #198cb3;
	color: #ffffff;
	border-color: #198cb3;
}

QToolBar {
	background-color: #ffffff;
	border: none;
	border-bottom: 1px solid #e0e0e0;
	padding: 4px;
	spacing: 4px;
}

QMenuBar {
	background-color: #ffffff;
	color: #1a1a1a;
	padding: 2px;
}

QMenuBar::item {
	background: transparent;
	padding: 6px 10px;
	border-radius: 4px;
}

QMenuBar::item:selected {
	background-color: #e8e8e8;
}

QMenu {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #d0d0d0;
	padding: 4px;
}

QMenu::item {
	padding: 6px 24px 6px 12px;
	border-radius: 4px;
}

QMenu::item:selected {
	background-color: #198cb3;
	color: #ffffff;
}

QMenu::separator {
	height: 1px;
	background: #e0e0e0;
	margin: 4px 8px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QComboBox {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #c8c8c8;
	border-radius: 4px;
	padding: 5px 8px;
	min-height: 22px;
	selection-background-color: #198cb3;
	selection-color: #ffffff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
	border-color: #198cb3;
}

QComboBox::drop-down {
	border: none;
	width: 22px;
}

QComboBox QAbstractItemView {
	background-color: #ffffff;
	color: #1a1a1a;
	border: 1px solid #d0d0d0;
	selection-background-color: #198cb3;
	outline: 0;
}

QCheckBox,
QRadioButton {
	background-color: transparent;
	spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
	width: 16px;
	height: 16px;
	border: 1px solid #8a8a8a;
	background-color: #ffffff;
}

QCheckBox::indicator {
	border-radius: 3px;
}

QRadioButton::indicator {
	border-radius: 8px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
	background-color: #198cb3;
	border-color: #198cb3;
}

QTabWidget::pane {
	border: 1px solid #d0d0d0;
	background-color: #ffffff;
	border-radius: 4px;
	top: -1px;
}

QTabBar::tab {
	background-color: #ececec;
	color: #444444;
	border: 1px solid #d0d0d0;
	padding: 7px 16px;
	margin-right: 2px;
	border-top-left-radius: 4px;
	border-top-right-radius: 4px;
}

QTabBar::tab:selected {
	background-color: #ffffff;
	color: #1a1a1a;
	border-bottom-color: #ffffff;
}

QHeaderView::section {
	background-color: #f3f3f3;
	color: #1a1a1a;
	border: none;
	border-right: 1px solid #e0e0e0;
	border-bottom: 1px solid #e0e0e0;
	padding: 6px 8px;
	font-weight: 600;
}

QTreeView,
QListView,
QTableView,
QTableWidget,
QTreeWidget,
QListWidget {
	background-color: #ffffff;
	alternate-background-color: #f7f7f7;
	color: #1a1a1a;
	border: 1px solid #d0d0d0;
	border-radius: 4px;
	outline: 0;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
	background-color: #198cb3;
	color: #ffffff;
}

QScrollBar:vertical {
	background: #f3f3f3;
	width: 12px;
	border: none;
}

QScrollBar::handle:vertical {
	background: #c0c0c0;
	min-height: 24px;
	border-radius: 6px;
	margin: 2px;
}

QScrollBar::handle:vertical:hover {
	background: #198cb3;
}

QScrollBar:horizontal {
	background: #f3f3f3;
	height: 12px;
	border: none;
}

QScrollBar::handle:horizontal {
	background: #c0c0c0;
	min-width: 24px;
	border-radius: 6px;
	margin: 2px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
	width: 0;
	height: 0;
}

QSlider::groove:horizontal {
	height: 4px;
	background: #d0d0d0;
	border-radius: 2px;
}

QSlider::handle:horizontal {
	background: #198cb3;
	width: 14px;
	height: 14px;
	margin: -5px 0;
	border-radius: 7px;
}

QProgressBar {
	background-color: #ffffff;
	border: 1px solid #d0d0d0;
	border-radius: 4px;
	text-align: center;
}

QProgressBar::chunk {
	background-color: #198cb3;
	border-radius: 3px;
}

QStatusBar {
	background-color: #ffffff;
	color: #555555;
	border-top: 1px solid #e0e0e0;
}

QSplitter::handle {
	background-color: #e8e8e8;
}

QSplitter::handle:hover {
	background-color: #198cb3;
}

QToolTip {
	background-color: #198cb3;
	color: #ffffff;
	border: none;
	padding: 6px 8px;
	border-radius: 4px;
}
