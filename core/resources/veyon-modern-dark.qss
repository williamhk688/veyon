/* Veyon classroom studio — dark
 * Navy canvas, elevated cards, luminous teal. Backgrounds are set on
 * windows and surfaces only so nested widgets stay transparent. */

QWidget {
	font-family: "Noto Sans", "DejaVu Sans", "Segoe UI", "Microsoft YaHei UI", sans-serif;
	font-size: 13px;
	color: #e8eef8;
	selection-background-color: #0891b2;
	selection-color: #ffffff;
}

QMainWindow,
QDialog,
QWizard,
QMessageBox,
QStackedWidget {
	background-color: #0b1020;
}

QAbstractScrollArea {
	background-color: #0b1020;
	border: none;
}

QFrame {
	background-color: transparent;
	color: #e8eef8;
}

QLabel {
	background-color: transparent;
	color: #e8eef8;
	padding: 2px;
}

QGroupBox {
	background-color: #1e2a44;
	border: 1px solid #3b4d6e;
	border-radius: 14px;
	margin-top: 18px;
	padding: 16px 14px 14px 14px;
	font-weight: 600;
}

QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 16px;
	padding: 0 8px;
	color: #7dd3fc;
	font-size: 12px;
	font-weight: 700;
}

QPushButton {
	background-color: #1c2740;
	color: #e8eef8;
	border: 1px solid #334155;
	border-radius: 12px;
	padding: 8px 18px;
	min-height: 24px;
	font-weight: 600;
}

QPushButton:hover {
	background-color: #243152;
	border-color: #22d3ee;
	color: #ffffff;
}

QPushButton:pressed {
	background-color: #0e7490;
	border-color: #0e7490;
	color: #ffffff;
}

QPushButton:disabled {
	background-color: #121826;
	color: #64748b;
	border-color: #1e293b;
}

QPushButton:default {
	background-color: #0891b2;
	border-color: #0891b2;
	color: #ffffff;
}

QPushButton:default:hover {
	background-color: #06b6d4;
	border-color: #67e8f9;
}

QToolButton {
	background-color: transparent;
	color: #cbd5e1;
	border: 1px solid transparent;
	border-radius: 12px;
	padding: 8px 12px;
	margin: 2px;
	font-weight: 600;
}

QToolButton:hover {
	background-color: #1c2740;
	border-color: #334155;
	color: #ffffff;
}

QToolButton:pressed,
QToolButton:checked {
	background-color: #0891b2;
	color: #ffffff;
	border-color: #22d3ee;
}

QToolButton:disabled {
	color: #64748b;
}

QToolBar {
	background-color: #10182b;
	border: none;
	border-bottom: 1px solid #243049;
	padding: 8px 10px;
	spacing: 8px;
}

QToolBar QToolButton {
	padding: 10px 14px;
	min-height: 28px;
}

QMenuBar {
	background-color: #10182b;
	color: #e8eef8;
	padding: 4px 8px;
	border-bottom: 1px solid #243049;
}

QMenuBar::item {
	background: transparent;
	padding: 7px 12px;
	border-radius: 8px;
}

QMenuBar::item:selected {
	background-color: #1c2740;
}

QMenu {
	background-color: #151c2e;
	color: #e8eef8;
	border: 1px solid #2a3550;
	border-radius: 12px;
	padding: 8px;
}

QMenu::item {
	padding: 8px 28px 8px 14px;
	border-radius: 8px;
}

QMenu::item:selected {
	background-color: #0891b2;
	color: #ffffff;
}

QMenu::separator {
	height: 1px;
	background: #2a3550;
	margin: 6px 10px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit,
QComboBox {
	background-color: #0f172a;
	color: #e8eef8;
	border: 1px solid #334155;
	border-radius: 12px;
	padding: 7px 12px;
	min-height: 24px;
	selection-background-color: #0891b2;
	selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
	border-color: #22d3ee;
	background-color: #111c33;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
	background-color: #121826;
	color: #64748b;
}

QComboBox::drop-down {
	border: none;
	width: 24px;
}

QComboBox QAbstractItemView {
	background-color: #151c2e;
	color: #e8eef8;
	border: 1px solid #2a3550;
	border-radius: 10px;
	selection-background-color: #0891b2;
	outline: 0;
	padding: 4px;
}

QCheckBox,
QRadioButton {
	background-color: transparent;
	color: #e8eef8;
	spacing: 10px;
}

QCheckBox::indicator,
QRadioButton::indicator {
	width: 18px;
	height: 18px;
	border: 1px solid #475569;
	background-color: #0f172a;
}

QCheckBox::indicator {
	border-radius: 6px;
}

QRadioButton::indicator {
	border-radius: 9px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
	background-color: #0891b2;
	border-color: #22d3ee;
}

QTabWidget::pane {
	border: 1px solid #3b4d6e;
	background-color: #1e2a44;
	border-radius: 14px;
	top: -1px;
	padding: 8px;
}

QTabBar::tab {
	background-color: transparent;
	color: #94a3b8;
	border: none;
	padding: 10px 18px;
	margin-right: 4px;
	border-top-left-radius: 10px;
	border-top-right-radius: 10px;
	font-weight: 600;
}

QTabBar::tab:selected {
	background-color: #141b2d;
	color: #7dd3fc;
	border-bottom: 2px solid #22d3ee;
}

QTabBar::tab:hover:!selected {
	color: #e8eef8;
	background-color: #1c2740;
}

QHeaderView::section {
	background-color: #141b2d;
	color: #94a3b8;
	border: none;
	border-right: 1px solid #243049;
	border-bottom: 1px solid #243049;
	padding: 8px 10px;
	font-weight: 700;
}

QTreeView,
QListView,
QTableView,
QTableWidget,
QTreeWidget,
QListWidget {
	background-color: #0f172a;
	alternate-background-color: #141b2d;
	color: #e8eef8;
	border: 1px solid #2a3550;
	border-radius: 14px;
	outline: 0;
	padding: 4px;
}

QTreeView::item,
QListView::item,
QTableView::item {
	padding: 6px 8px;
	min-height: 24px;
	border-radius: 8px;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
	background-color: #0891b2;
	color: #ffffff;
}

QTreeView::item:hover:!selected,
QListView::item:hover:!selected {
	background-color: #1c2740;
}

QListView#computerMonitoringWidget {
	background-color: #0b1020;
	border: none;
	border-radius: 0;
	padding: 16px;
}

QWidget#configuratorSidebar {
	background-color: #10182b;
	border-right: 1px solid #243049;
}

QLabel#configuratorBrandTitle {
	color: #22d3ee;
	font-size: 18px;
	font-weight: 800;
	letter-spacing: 0.5px;
	padding: 20px 18px 2px 18px;
}

QLabel#configuratorBrandSubtitle {
	color: #94a3b8;
	font-size: 11px;
	font-weight: 600;
	padding: 0 18px 12px 18px;
}

QListWidget#pageSelector {
	background-color: #10182b;
	border: none;
	border-radius: 0;
	padding: 8px 8px 16px 8px;
	min-width: 196px;
	outline: 0;
}

QListWidget#pageSelector::item {
	padding: 12px 12px;
	margin: 3px 2px;
	border-radius: 12px;
	color: #cbd5e1;
}

QListWidget#pageSelector::item:hover {
	background-color: #1c2740;
	color: #ffffff;
}

QListWidget#pageSelector::item:selected {
	background-color: #0e7490;
	color: #ffffff;
}

QWidget#configuratorFooter {
	background-color: #10182b;
	border-top: 1px solid #243049;
}

QScrollArea {
	background-color: transparent;
	border: none;
}

QScrollArea#scrollArea QGroupBox {
	padding: 12px 10px 10px 10px;
}

QScrollArea#scrollArea QPushButton {
	padding: 6px 12px;
}

QScrollBar:vertical {
	background: transparent;
	width: 10px;
	margin: 4px 2px;
	border: none;
}

QScrollBar::handle:vertical {
	background: #334155;
	min-height: 28px;
	border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
	background: #22d3ee;
}

QScrollBar:horizontal {
	background: transparent;
	height: 10px;
	margin: 2px 4px;
	border: none;
}

QScrollBar::handle:horizontal {
	background: #334155;
	min-width: 28px;
	border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
	background: #22d3ee;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
	width: 0;
	height: 0;
	background: transparent;
}

QSlider::groove:horizontal {
	height: 6px;
	background: #1e293b;
	border-radius: 3px;
}

QSlider::handle:horizontal {
	background: #22d3ee;
	width: 16px;
	height: 16px;
	margin: -6px 0;
	border-radius: 8px;
}

QSlider::sub-page:horizontal {
	background: #0891b2;
	border-radius: 3px;
}

QProgressBar {
	background-color: #0f172a;
	border: 1px solid #2a3550;
	border-radius: 10px;
	text-align: center;
	color: #e8eef8;
	min-height: 18px;
	font-weight: 600;
}

QProgressBar::chunk {
	background-color: #0891b2;
	border-radius: 8px;
}

QStatusBar {
	background-color: #10182b;
	color: #94a3b8;
	border-top: 1px solid #243049;
	padding: 8px 12px;
}

QStatusBar QLineEdit {
	min-width: 200px;
	min-height: 22px;
}

QStatusBar QToolButton {
	padding: 6px 12px;
}

QSplitter::handle {
	background-color: #10182b;
}

QSplitter::handle:horizontal {
	width: 8px;
}

QSplitter::handle:vertical {
	height: 8px;
}

QSplitter::handle:hover {
	background-color: #22d3ee;
}

QDockWidget {
	titlebar-close-icon: none;
	titlebar-normal-icon: none;
	color: #e8eef8;
}

QDockWidget::title {
	background-color: #141b2d;
	padding: 8px;
	border-radius: 8px;
}

QToolTip {
	background-color: #0891b2;
	color: #ffffff;
	border: none;
	padding: 8px 10px;
	border-radius: 8px;
	font-weight: 600;
}

QDialogButtonBox {
	dialogbuttonbox-buttons-have-icons: 0;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
	background-color: #1c2740;
	border: none;
	width: 18px;
	border-radius: 6px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
	background-color: #0891b2;
}
